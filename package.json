{
  "name": "islamic-learning-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "prepare:semantic": "node server/scripts/prepare-semantic.ts",
    "prepare:translation": "node --env-file=.env.local server/scripts/prepare-translation.ts",
    "rebuild:documents": "node server/scripts/rebuild-documents.ts",
    "audit:init": "node server/scripts/audit-init.ts",
    "auth:user": "node server/auth/cli.ts",
    "telegram:poll": "node --env-file-if-exists=.env.local server/channels/telegram/run.ts",
    "test:local": "node --test \"src/**/*.test.js\" \"tests/admin/*.test.ts\" \"tests/chat/*.test.ts\" \"tests/pwa/*.test.ts\" \"server/**/*.test.ts\"",
    "test:acceptance": "node --test --test-reporter=spec tests/acceptance/answer-service.acceptance.test.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "lucide-react": "0.446.0",
    "mammoth": "1.12.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "sharp": "0.35.3"
  }
}
